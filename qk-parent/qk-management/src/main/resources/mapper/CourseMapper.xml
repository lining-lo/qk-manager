<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.qk.mapper.CourseMapper">

    <!--根据条件查询课程
     List<Course> list(Integer subject,String name, Integer target);-->
    <select id="list" resultType="com.qk.entity.Course">
        SELECT id, subject, name, price, target, description, create_time, update_time
        FROM course
        <where>
            <if test="subject != null">
                AND subject = #{subject}
            </if>
            <if test="name != null and name != ''">
                AND name LIKE CONCAT('%', #{name}, '%')
            </if>
            <if test="target != null">
                AND target = #{target}
            </if>
        </where>
        ORDER BY update_time DESC
    </select>

    <!-- 修改课程信息 -->
    <update id="updateById" >
        UPDATE course
        <set>
            <if test="subject != null">
                subject = #{subject},
            </if>
            <if test="name != null and name != ''">
                name = #{name},
            </if>
            <if test="price != null">
                price = #{price},
            </if>
            <if test="target != null">
                target = #{target},
            </if>
            <if test="description != null and description != ''">
                description = #{description},
            </if>
            <if test="updateTime != null">
                update_time = #{updateTime},
            </if>
        </set>
        WHERE id = #{id}
    </update>
</mapper>